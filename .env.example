# Frontend public configuration.
# Copy these values into a script that sets window.DERRA_COMMERCE_CONFIG
# before commerce.js is loaded, or inject them from your hosting platform.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Supabase Edge Functions secrets.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id
CINETPAY_MODE=PRODUCTION
